# Copie este arquivo para .env e troque as senhas antes de iniciar o MySQL.
MYSQL_ROOT_PASSWORD=troque-esta-senha-root
MYSQL_DATABASE=projeto_financeiro
MYSQL_USER=projeto_financeiro
MYSQL_PASSWORD=troque-esta-senha
MYSQL_PORT=3307
TZ=America/Sao_Paulo

# URL para o backend executado diretamente na sua maquina.
URL_BANCO_DADOS=mysql+pymysql://projeto_financeiro:troque-esta-senha@localhost:3307/projeto_financeiro
# Obrigatorio, minimo de 32 caracteres. Gere com:
# python -c "import secrets; print(secrets.token_urlsafe(48))"
SEGREDO_JWT=
MINUTOS_EXPIRACAO_JWT=60

# Origens do frontend autorizadas (CORS e verificacao de Origin), separadas por virgula.
ORIGENS_CORS=http://localhost:5173,http://127.0.0.1:5173
# Cookie de sessao so trafega em HTTPS. Navegadores aceitam em http://localhost;
# use false apenas se precisar testar por IP da rede local sem HTTPS.
COOKIE_SEGURO=true
DEPURACAO=false
