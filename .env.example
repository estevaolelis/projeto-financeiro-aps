# Copie este arquivo para .env e troque as senhas antes de iniciar o MySQL.
MYSQL_ROOT_PASSWORD=troque-esta-senha-root
MYSQL_DATABASE=projeto_financeiro
MYSQL_USER=projeto_financeiro
MYSQL_PASSWORD=troque-esta-senha
MYSQL_PORT=3307
TZ=America/Sao_Paulo

# URL para o backend executado diretamente na sua maquina.
URL_BANCO_DADOS=mysql+pymysql://projeto_financeiro:troque-esta-senha@localhost:3307/projeto_financeiro
SEGREDO_JWT=troque-esta-chave-em-cada-ambiente
MINUTOS_EXPIRACAO_JWT=120
